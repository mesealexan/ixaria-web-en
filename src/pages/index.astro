---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { pageSEO } from '../seo/pages';
import { homeStructuredData } from '../seo/structured-data';
import Hero from '../components/sections/Hero.astro';
import Method from '../components/sections/Method.astro';
import VisitorConversion from '../components/sections/VisitorConversion.astro';
import Solution from '../components/sections/Solution.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import CustomerStoryTeaser from '../components/sections/CustomerStoryTeaser.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Features from '../components/sections/Features.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import About from '../components/sections/About.astro';
import FAQ from '../components/sections/FAQ.astro';
import '../styles/home.css';
import '../styles/design-home.css';
import ChatDialog from '../features/chat/ChatDialog.astro';
---
<MarketingLayout seo={pageSEO.home} structuredData={homeStructuredData()}>
  <div class="hero-intro">
    <Hero />
    <ClientLogos marquee />
  </div>
  <VisitorConversion />
  <Solution />
  <BeforeAfter />
  <Method />
  <CustomerStoryTeaser />
  <HowItWorks />
  <CallToAction />
  <Features />
  <About />
  <Newsletter />
  <FAQ />
  <Fragment slot="after-footer">
    <ChatDialog />
    <noscript><style is:inline>html{scroll-behavior:auto}.feature-card,.process-card,.value-item,.cta-strip__inner,.cta-strip__btn-wrap{opacity:1!important;transform:none!important}.faq__answer{display:block!important}</style></noscript>
  </Fragment>
</MarketingLayout>
<script>import '../features/animations/reveal';</script>
