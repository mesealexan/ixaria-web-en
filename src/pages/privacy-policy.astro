---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';
import { pageSEO } from '../seo/pages';
const entry = await getEntry('legal', 'privacy-policy');
if (!entry) throw new Error('Missing legal content: privacy-policy');
const { Content } = await render(entry);
---
<LegalLayout seo={pageSEO['privacy-policy']} content={entry.data}>
  <Content />
</LegalLayout>
