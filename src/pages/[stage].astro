---
import { implementationStages } from '../data/implementation';
import type { ImplementationStage } from '../data/implementation';
import { pageSEO } from '../seo/pages';
import { implementationStructuredData } from '../seo/implementation';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LivePage from '../components/sections/LivePage.astro';
import PilotPage from '../components/pilot/PilotPage.astro';

export function getStaticPaths() {
  return implementationStages.filter(stage => stage.slug !== 'review').map(stage => ({ params: { stage: stage.slug }, props: { stage } }));
}
interface Props { stage: ImplementationStage }
const { stage } = Astro.props;
---
<MarketingLayout seo={pageSEO[stage.slug]} structuredData={implementationStructuredData(stage)}>
  {stage.slug === 'pilot' ? <PilotPage /> : <LivePage />}
</MarketingLayout>
