---
import type { ContentCard } from '../../data/types';
interface Props { items: ContentCard[] }
const { items } = Astro.props;
---
<div class="features__grid">
  {items.map(item => (
    <div class="feature-card"><img {...item.image} class="feature-icon" loading="lazy" /><h3 class="feature-title">{item.title}</h3><p class="feature-body">{item.body}</p></div>
  ))}
</div>
