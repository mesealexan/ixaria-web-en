---
import type { Founder } from '../../data/types';
interface Props { items: Founder[] }
const { items } = Astro.props;
---
<div class="founders">
  {items.map(founder => <div class="founder">
    <div class="founder__avatar"><img {...founder.image} loading="lazy" /></div>
    <div class="founder__name">{founder.name}</div><div class="founder__role">{founder.role}</div>
    <a href={founder.linkedin} target="_blank" rel="noopener noreferrer" class="founder__linkedin">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></svg>
      LinkedIn
    </a>
  </div>)}
</div>
