---
import { site } from '../../data/site';
import { socialPreviewTitle } from '../../seo/metadata';
import { serializeStructuredData } from '../../seo/structured-data';
import type { PageSEO, StructuredData } from '../../seo/types';
interface Props { seo: PageSEO; structuredData?: StructuredData }
const { seo, structuredData } = Astro.props;
const canonical = new URL(seo.path, site.url).href;
const og = seo.openGraph;
const socialImage = og?.image ?? `${site.url}/webpreview.webp`;
const socialImageAlt = og?.imageAlt ?? site.name;
const twitter = seo.twitter ?? {
  card: 'summary_large_image',
  title: og?.title ?? seo.title,
  description: og?.description ?? seo.description,
  image: og?.image ?? `${site.url}/webpreview.webp`,
  imageAlt: og?.imageAlt ?? site.name,
};
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<meta name="theme-color" content={site.themeColor} />
<link rel="icon" type="image/svg+xml" href="/IXARIA-logo.svg" />
<link rel="canonical" href={canonical} />
{seo.alternates?.map(alternate => <link rel="alternate" hreflang={alternate.language} href={alternate.href} />)}
<meta property="og:type" content={og?.type ?? 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={socialPreviewTitle} />
<meta property="og:description" content={og?.description ?? seo.description} />
<meta property="og:site_name" content={site.name} />
{og?.locale && <meta property="og:locale" content={og.locale} />}
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={socialImageAlt} />
{(og?.imageWidth || socialImage.endsWith('/webpreview.webp')) && <meta property="og:image:width" content={og?.imageWidth ?? '1200'} />}
{(og?.imageHeight || socialImage.endsWith('/webpreview.webp')) && <meta property="og:image:height" content={og?.imageHeight ?? '630'} />}
{twitter && <>
  <meta name="twitter:card" content={twitter.card} />
  <meta name="twitter:title" content={socialPreviewTitle} />
  <meta name="twitter:description" content={twitter.description} />
  <meta name="twitter:image" content={twitter.image} />
  {twitter.imageAlt && <meta name="twitter:image:alt" content={twitter.imageAlt} />}
</>}
<link rel="preload" as="font" href="/fonts/inter-1.woff2" type="font/woff2" crossorigin />
<link rel="preload" as="font" href="/Gilroy-Black.woff2" type="font/woff2" crossorigin />
{structuredData && <script type="application/ld+json" set:html={serializeStructuredData(structuredData)} />}
