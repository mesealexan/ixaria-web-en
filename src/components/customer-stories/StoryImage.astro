---
import type { StoryImage } from '../../data/customer-stories/agache';
interface Props { image: StoryImage }
const { image } = Astro.props;
---
<figure class="story-image">
  <div class="story-image__label"><span>{image.label}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M5 3h8v8M13 3 3 13" stroke="currentColor" stroke-width="1.5" /></svg></div>
  <a href={image.src} class="story-image__link" data-story-enlarge aria-label={`Enlarge: ${image.alt}`}>
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
  </a>
  <figcaption>{image.caption}</figcaption>
</figure>
