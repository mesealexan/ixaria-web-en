---
import { auditAssets } from '../../data/audit-assets';
import { audit } from '../../data/audit';
---
{auditAssets.clientLogos.length > 0 && (
  <section class="audit-logos" data-audit-section="experience" aria-label={audit.logoCaption}>
    <div class="container">
      <p>{audit.logoCaption}</p>
      <ul>{auditAssets.clientLogos.map(logo => (
        <li><img {...logo.image} loading="lazy" decoding="async" /></li>
      ))}</ul>
    </div>
  </section>
)}
