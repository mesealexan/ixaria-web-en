---
import { auditAssets } from '../../data/audit-assets';
import { audit } from '../../data/audit';
const { example } = auditAssets;
---
<div class="audit-example">
  <h3>{audit.report.exampleHeading}</h3>
  <p>{audit.report.exampleDescription}</p>
  {example.pdfUrl ? (
    <a class="btn btn-primary" href={example.pdfUrl} download={example.downloadFilename}>{audit.report.downloadLabel}</a>
  ) : (
    <p class="audit-example__pending">{audit.report.missingLabel}</p>
  )}
</div>
