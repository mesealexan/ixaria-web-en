---
import { audit } from '../../data/audit';
import { auditAssets } from '../../data/audit-assets';
import Button from '../ui/Button.astro';
import Newsletter from '../sections/Newsletter.astro';
import { responsiveImage, serviceImageSizes, wideImageSizes, teamImageSizes } from '../../utils/images';
import '../../styles/audit.css';
---

<div class="audit-page">
  <section class="audit-section audit-hero" data-audit-section="hero" aria-labelledby="audit-title">
    <div class="container audit-grid">
      <div>
        <h1 id="audit-title">{audit.hero.heading} <span>{audit.hero.highlight}</span></h1>
        <p class="audit-lead">{audit.hero.description}</p>
        <div class="audit-offer">
          <p class="audit-price"><strong>{audit.price}</strong><span>{audit.hero.paymentLabel}</span></p>
          <p class="audit-delivery">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="14" cy="14" r="12" />
              <path d="M14 7v7l4 3" />
            </svg>
            <span>{audit.delivery}</span>
          </p>
        </div>
        <Button href={audit.bookingUrl} external class="audit-booking">{audit.bookingLabel}</Button>
      </div>
      <img
        class="audit-hero__media"
        src="/hero-audit.webp"
        {...responsiveImage('/hero-audit.webp', serviceImageSizes)}
        width="1254"
        height="1254"
        alt="Sofa product page answering a shopper's question about whether it will fit in their living room."
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="audit-section audit-receive" data-audit-section="receive" aria-labelledby="receive-title">
    <div class="container audit-grid audit-grid--image-left">
      <img
        class="audit-receive__media"
        src="/audit-results.webp"
        {...responsiveImage('/audit-results.webp', serviceImageSizes)}
        width="1448"
        height="1086"
        alt="Example conversion audit covering the success metric, customer questions, signals and responses, and implementation priorities."
        loading="lazy"
        decoding="async"
      />
      <div>
        <h2 class="section-title" id="receive-title">{audit.receive.heading}</h2>
        <p class="audit-lead">{audit.receive.description}</p>
        <ul class="audit-deliverables">
          {audit.receive.items.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="audit-section" data-audit-section="process" aria-labelledby="process-title">
    <div class="container">
      <div class="audit-section-heading">
        <h2 class="section-title" id="process-title">{audit.process.heading}</h2>
        <p class="audit-lead">{audit.process.description}</p>
      </div>
      <ol class="audit-cards audit-process">
        {audit.process.steps.map(step => (
          <li class="audit-card">
            <span class="audit-call-label">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="13" height="14" rx="2" />
                <path d="m15 10 7-4v12l-7-4" />
              </svg>
              {step.callLabel}
            </span>
            <h3>{step.heading}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="audit-process-cta">
        <Button href={audit.bookingUrl} external>Book your first call now</Button>
      </div>
    </div>
  </section>

  <section class="audit-section audit-approach" data-audit-section="approach" aria-labelledby="approach-title">
    <div class="container">
      <div class="audit-section-heading">
        <h2 class="section-title" id="approach-title">{audit.approach.heading}</h2>
        <p class="audit-lead">{audit.approach.description}</p>
      </div>
      <ol class="audit-cards audit-flow">
        {audit.approach.steps.map(step => (
          <li class="audit-card">
            <h3>{step.heading}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <img
        class="audit-approach__media"
        src="/audit-right-info2.webp"
        {...responsiveImage('/audit-right-info2.webp', wideImageSizes)}
        width="2172"
        height="724"
        alt="A shopper explores sofa fabrics online and receives relevant information about cleaning and fabric care."
        loading="lazy"
        decoding="async"
      />
      <p class="audit-note">{audit.approach.note}</p>
    </div>
  </section>

  <section class="audit-section" data-audit-section="team" aria-labelledby="team-title">
    <div class="container">
      <div class="audit-section-heading">
        <h2 class="section-title" id="team-title">{audit.team.heading}</h2>
        <p class="audit-lead">{audit.team.description}</p>
      </div>
      <div class="audit-cards audit-team">
        {audit.team.people.map(person => (
          <article>
            <img src={auditAssets.portraits[person.assetKey as keyof typeof auditAssets.portraits]} {...responsiveImage(auditAssets.portraits[person.assetKey as keyof typeof auditAssets.portraits], teamImageSizes)} alt={person.name} width="800" height="600" loading="lazy" decoding="async" />
            <h3>{person.name}</h3>
            <p class="audit-role">{person.role}</p>
            <p>{person.text}</p>
            <a class="audit-team__linkedin" href={person.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn (opens in a new tab)`}>LinkedIn <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Newsletter compact {...audit.newsletter} />

  <section class="audit-section audit-final" data-audit-section="final" aria-labelledby="final-title">
    <div class="container">
      <h2 class="section-title" id="final-title">{audit.final.heading}</h2>
      <p class="audit-lead">{audit.final.description}</p>
      <Button href={audit.bookingUrl} external>{audit.bookingLabel}</Button>
      <a class="audit-pilot-link" href={audit.final.pilotUrl}>{audit.final.pilotLabel}</a>
    </div>
  </section>
</div>
