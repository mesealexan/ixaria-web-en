---
import '../../styles/solution.css';

const views = [
  { name: 'B001', caption: 'Shopper needs', alt: 'Forma sofa listing asking what a sofa should handle, with options for kids, pets and liquid spills.' },
  { name: 'B002', caption: 'Recommended products', alt: 'Personalised Forma and Cave sofa recommendations with fabric features, reviews, prices and configuration options.' },
  { name: 'B003', caption: 'Sofa comparison', alt: 'Side-by-side Forma and Cove sofa comparison showing prices, fabric choices, cushion materials and seat firmness.' },
  { name: 'B004', caption: 'Personalised product view', alt: 'Forma sofa product page showing a dog on scratch-free fabric and personalised delivery and assembly services.' },
];
---
<section class="solution" id="solution" aria-labelledby="solution-title">
  <div class="container solution__heading">
    <h2 class="solution__title" id="solution-title">Ixaria converts more of your qualified visitors into <span>actual buyers.</span></h2>
    <p class="solution__subtitle">by understanding their needs, fears and cultural traits and showing them the right information at the right time.</p>
  </div>
  <div class="container solution__demo-container solution-views">
    {views.map(view => (
      <figure class="solution-view">
        <a class="solution-view__expand" href={`/design/${view.name}.webp`} aria-label={`View ${view.caption.toLowerCase()} full size`} aria-haspopup="dialog">
        <img
          class="solution-view__image"
          src={`/design/${view.name}.webp`}
          srcset={`/design/${view.name}-320.webp 320w, /design/${view.name}.webp 575w`}
          sizes="(max-width: 359px) calc((100vw - 48px) / 2), (max-width: 767px) calc((100vw - 56px) / 2), (max-width: 768px) calc((100vw - 64px) / 2), (max-width: 1023px) calc((100vw - 88px) / 2), (max-width: 1199px) calc((100vw - 136px) / 4), (max-width: 1295px) calc((100vw - 168px) / 4), 282px"
          width="575"
          height="1176"
          alt={view.alt}
          loading="lazy"
          decoding="async"
        />
        </a>
        <figcaption>{view.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
<dialog class="solution-lightbox" aria-label="Full-size solution image">
  <button class="solution-lightbox__close" type="button" aria-label="Close full-size image">
    <img src="/design/B001.webp" width="575" height="1176" alt="" loading="lazy" decoding="async" />
  </button>
</dialog>
<script>
  import '../../features/solution-images';
</script>
