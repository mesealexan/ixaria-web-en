---
import '../../styles/solution.css';

const views = [
  { name: 'standard', caption: 'Standard product view', alt: 'Standard Forma sofa product page with a beige sofa, product information, price and fabric swatches.' },
  { name: 'pets', caption: 'Pet-focused view', alt: 'Pet-focused Forma sofa product page showing a cat on the sofa, scratch-free fabric and pet-friendly fabric choices.' },
  { name: 'kids', caption: 'Kids-focused view', alt: 'Kids-focused Forma sofa product page showing a child spilling a drink, easy-clean fabric and fabric choices for everyday spills.' },
];
---
<section class="solution" id="solution" aria-labelledby="solution-title">
  <div class="container solution__heading">
    <h2 class="solution__title" id="solution-title">Ixaria converts more of your qualified visitors into <span>actual buyers.</span></h2>
    <p class="solution__subtitle">by understanding their needs, fears and cultural traits and showing them the right information at the right time.</p>
  </div>
  <div class="container solution__demo-container solution-views">
    {views.map(view => (
      <figure class="solution-view">
        <img
          class="solution-view__image"
          src={`/design/solution-${view.name}-800.webp`}
          srcset={`/design/solution-${view.name}-400.webp 400w, /design/solution-${view.name}-800.webp 800w`}
          sizes="(max-width: 479px) calc(100vw - 40px), (max-width: 767px) 420px, (max-width: 1295px) calc((100vw - 144px) / 3), 384px"
          width="800"
          height="1425"
          alt={view.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{view.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
