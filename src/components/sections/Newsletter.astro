---
import { integrations } from '../../data/integrations';
import { responsiveImage } from '../../utils/images';
interface Props { compact?: boolean; heading?: string; description?: string; buttonLabel?: string }
const {
  compact = false,
  heading = 'Not ready to change your product pages yet?',
  description = 'Join our updates and follow how furniture manufacturers are turning complex products, configurators, and product data into better online buying experiences.',
  buttonLabel = 'Stay in the loop',
} = Astro.props;
---
<section class="email-capture" id="newsletter" data-audit-section={compact ? 'newsletter' : undefined} aria-labelledby="newsletter-title">
      <div class="email-capture__inner">
        {!compact && <div class="email-capture__img">
          <img src="/newsletter.webp" {...responsiveImage('/newsletter.webp', '(max-width: 1160px) calc((100vw - 144px) / 2), 508px')} width="1672" height="941" alt="Cream sofa in a sunlit room with a heart-shaped shadow on the wall" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;">
        </div>}
        <div class="email-capture__form-area">
          <h2 class="section-title" id="newsletter-title" style={compact ? undefined : 'max-width:440px;'}>{heading}</h2>
          <p class="section-sub">{description}</p>
          <form id="sib-form" class="email-form" method="POST" action={integrations.newsletterAction} data-type="subscription" style="background-color:transparent; margin:0; padding:0;">
            <input id="EMAIL" name="EMAIL" autocomplete="email" data-required="true" required="" type="email" placeholder="Work email" aria-label="Work email">
            <button type="submit" class="btn btn-primary">{buttonLabel}</button>
            <input type="text" name="email_address_check" value="" style="display:none;">
            <input type="hidden" name="locale" value="en">
          </form>
          <div id="email-msg-error" class="email-msg email-msg--error" role="alert">Please enter a valid email address.</div>
          <div id="email-msg-success" class="email-msg email-msg--success" role="status">You're in! We'll be in touch with practical
            ideas for your product pages.</div>
          {!compact && <div class="email-reassurance">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Occasional updates. No spam. Only practical ideas about furniture ecommerce, product pages, and conversion.
          </div>}
        </div>
      </div>
    </section>
<script>import "../../features/newsletter/newsletter";</script>
