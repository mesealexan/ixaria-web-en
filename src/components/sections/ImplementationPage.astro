---
import { fullImplementation } from '../../data/full-implementation';
import Button from '../ui/Button.astro';
import { responsiveImage, serviceImageSizes } from '../../utils/images';
import '../../styles/audit.css';
import '../../styles/pilot.css';
import '../../styles/design-services.css';
---

<div class="audit-page full-implementation-page">
  <section class="audit-section audit-hero" data-implementation-section="hero" aria-labelledby="implementation-title">
    <div class="container audit-grid">
      <div>
        <h1 id="implementation-title">{fullImplementation.hero.heading} <span>{fullImplementation.hero.highlight}</span></h1>
        <p class="audit-lead">{fullImplementation.hero.description}</p>
        <div class="pilot-offer">
          <p class="pilot-price"><strong>{fullImplementation.price}</strong><span class="implementation-revenue-share">{fullImplementation.revenueShare}</span></p>
        </div>
        <Button href={fullImplementation.bookingUrl} external>{fullImplementation.bookingLabel}</Button>
      </div>
      <img
        class="audit-hero__media"
        src="/full-hero.webp"
        {...responsiveImage('/full-hero.webp', serviceImageSizes)}
        width="1254"
        height="1254"
        alt="Furniture product pages showing relevant fabric, dimension, and delivery information across a product catalog."
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="audit-section audit-receive" data-implementation-section="implement" aria-labelledby="implementation-implement-title">
    <div class="container audit-grid audit-grid--image-left">
      <img
        class="audit-receive__media"
        src="/full-three.webp"
        {...responsiveImage('/full-three.webp', serviceImageSizes)}
        width="1448"
        height="1086"
        alt="Shopper signals connect with visitor context to show relevant sofa comfort and dining-table dimension information."
        loading="lazy"
        decoding="async"
      />
      <div>
        <h2 class="section-title" id="implementation-implement-title">{fullImplementation.implement.heading}</h2>
        <p class="audit-lead">{fullImplementation.implement.description}</p>
        <ul class="pilot-implementation-list">
          {fullImplementation.implement.points.map(point => (
            <li>
              <h3>{point.heading}</h3>
              <p>{point.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="audit-section" data-implementation-section="rollout" aria-labelledby="implementation-rollout-title">
    <div class="container">
      <div class="audit-section-heading">
        <h2 class="section-title" id="implementation-rollout-title">{fullImplementation.rollout.heading}</h2>
        <p class="audit-lead">{fullImplementation.rollout.description}</p>
      </div>
      <ol class="audit-cards pilot-steps" role="list">
        {fullImplementation.rollout.steps.map((step, index) => (
          <li class="audit-card">
            <span class="pilot-step-number" aria-hidden="true">{index + 1}</span>
            <h3>{step.heading}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="audit-section audit-approach pilot-measurement" data-implementation-section="measurement" aria-labelledby="implementation-measurement-title">
    <div class="container audit-grid">
      <div>
        <h2 class="section-title" id="implementation-measurement-title">{fullImplementation.measurement.heading}</h2>
        <p class="audit-lead">{fullImplementation.measurement.description}</p>
      </div>
      <img
        class="pilot-measurement__media"
        src="/full-measure.webp"
        {...responsiveImage('/full-measure.webp', serviceImageSizes)}
        width="1448"
        height="1086"
        alt="A blue sofa beneath an upward-trending line illustrating ongoing performance measurement."
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <section class="audit-section audit-final" data-implementation-section="final" aria-labelledby="implementation-final-title">
    <div class="container">
      <h2 class="section-title" id="implementation-final-title">{fullImplementation.final.heading}</h2>
      <p class="audit-lead">{fullImplementation.final.description}</p>
      <p class="pilot-final-price"><span class="implementation-monthly-price">{fullImplementation.price}</span><span class="implementation-revenue-share">{fullImplementation.revenueShare}</span></p>
      <Button href={fullImplementation.bookingUrl} external>{fullImplementation.bookingLabel}</Button>
      <img class="service-closing__sofa" role="presentation" src="/design/blue-sofa-1200.webp" srcset="/design/blue-sofa-640.webp 640w, /design/blue-sofa-1200.webp 1200w" sizes="(max-width: 768px) 90vw, 540px" width="1200" height="800" alt="" loading="lazy" decoding="async" />
    </div>
  </section>
</div>
