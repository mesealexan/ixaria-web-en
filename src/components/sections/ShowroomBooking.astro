<aside class="solution-showroom" data-showroom-booking aria-label="Book a showroom visit">
  <div class="solution-showroom__widgets">
    <div class="solution-showroom__map">
      <svg viewBox="0 0 240 200" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Map preview with the nearest showroom marked">
        <rect width="240" height="200" fill="#e8ebe6" />
        <path d="M0 0h75l-9 48H0ZM157 123h83v77h-60ZM8 139h55v61H0Z" fill="#d5dfcd" />
        <path d="M170-10c-44 49 38 75-6 118s-17 63-41 102" fill="none" stroke="#c3d9e1" stroke-width="17" />
        <g fill="none" stroke="#fff" stroke-width="10">
          <path d="m-10 74 260 43M65-10l35 220M-10 167l260-91M204-10 89 210" />
        </g>
        <g fill="#d7d9d3">
          <rect x="18" y="92" width="29" height="23" rx="3" transform="rotate(9 18 92)" />
          <rect x="108" y="24" width="28" height="20" rx="3" transform="rotate(9 108 24)" />
          <rect x="189" y="137" width="25" height="22" rx="3" transform="rotate(9 189 137)" />
        </g>
        <circle cx="113" cy="113" r="24" fill="#090959" opacity=".08" />
        <path d="M113 78a15 15 0 0 0-15 15c0 12 15 27 15 27s15-15 15-27a15 15 0 0 0-15-15Z" fill="#090959" />
        <circle cx="113" cy="93" r="5" fill="#fff" />
      </svg>
      <span class="solution-showroom__location"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 10 9-7 9 7v11H3V10ZM9 21v-7h6v7" /></svg>Nearest center</span>
    </div>
    <div class="solution-showroom__date-picker" data-showroom-picker>
      <button class="solution-showroom__date-toggle" type="button" data-showroom-date-toggle aria-label="Choose a showroom visit date" aria-expanded="false" aria-controls="showroom-visit-calendar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v16H4zM8 3v4m8-4v4M4 10h16" /></svg>
        <span data-showroom-date-label>Choose a date</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
    <div class="solution-showroom__calendar" id="showroom-visit-calendar" data-showroom-calendar role="group" aria-label="Choose a showroom visit date" hidden>
      <div class="solution-showroom__month-nav">
        <button type="button" data-showroom-previous aria-label="Previous month"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
        <strong data-showroom-month aria-live="polite">Choose a date</strong>
        <button type="button" data-showroom-next aria-label="Next month"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
      </div>
      <div class="solution-showroom__weekdays" aria-hidden="true"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>
      <div class="solution-showroom__days" data-showroom-days></div>
    </div>
    </div>
  </div>
  <button class="solution-showroom__book" type="button" data-showroom-book disabled>Book a showroom visit to your nearest center</button>
  <p class="solution-showroom__status" data-showroom-status role="status"></p>
</aside>

<script>import '../../features/solution/showroom';</script>
