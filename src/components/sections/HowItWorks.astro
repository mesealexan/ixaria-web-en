---
import { implementationStages, implementationPath } from '../../data/implementation';
import '../../styles/how-it-works.css';
---
<section class="how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <div class="how__header">
      <div><span class="section-label">A clear path forward</span><h2 class="section-title" id="how-title">How it works</h2></div>
      <p class="how__intro">Understand the opportunity. Prove the approach.<br />Then build on what works.</p>
    </div>
    <ol class="how__journey" aria-label="Implementation stages">
      {implementationStages.map((stage, index) => (
        <li class:list={['process-card', `process-card--${stage.slug}`]}>
          <div class="process-card__top"><span class="process-card__number" aria-hidden="true">0{index + 1}</span><span class="process-card__label">{stage.label}</span></div>
          <h3>{stage.title}</h3>
          <p>{stage.summary}</p>
          <a class="process-card__link" href={implementationPath(stage)}>
            Explore {stage.title === 'Full Implementation' ? stage.title : `the ${stage.title}`}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
