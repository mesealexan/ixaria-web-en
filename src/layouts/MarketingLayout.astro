---
import BaseLayout from './BaseLayout.astro';
import type { PageSEO, StructuredData } from '../seo/types';
interface Props { seo: PageSEO; structuredData?: StructuredData; integrations?: boolean }
const { seo, structuredData, integrations } = Astro.props;
---
<BaseLayout seo={seo} structuredData={structuredData} integrations={integrations}>
  <slot />
  <slot name="after-footer" slot="after-footer" />
</BaseLayout>
